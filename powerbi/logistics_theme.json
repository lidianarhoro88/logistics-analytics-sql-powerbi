{
  "name": "Logistics Navy",
  "dataColors": [
    "#1F4E79",
    "#2E86AB",
    "#F18F01",
    "#C73E1D",
    "#3B8B5E",
    "#6C5B7B",
    "#A3B8CC",
    "#E0A458"
  ],
  "background": "#FFFFFF",
  "foreground": "#1B2A3A",
  "tableAccent": "#1F4E79",
  "good": "#3B8B5E",
  "neutral": "#F18F01",
  "bad": "#C73E1D",
  "maximum": "#3B8B5E",
  "center": "#F6D365",
  "minimum": "#C73E1D",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#1B2A3A" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1B2A3A" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#4A5A6A" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1F4E79" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F6FA" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#DDE3EA" } }, "radius": 8 }],
        "dropShadow": [{ "show": true, "position": "Outer", "preset": "BottomRight", "transparency": 85 }],
        "title": [{ "fontColor": { "solid": { "color": "#1B2A3A" } }, "fontSize": 12, "bold": true }],
        "padding": [{ "top": 8, "bottom": 8, "left": 10, "right": 10 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#1F4E79" } }, "bold": true }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "backColor": { "solid": { "color": "#1F4E79" } }, "fontColor": { "solid": { "color": "#FFFFFF" } }, "bold": true }],
        "values": [{ "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#F3F6FA" } } }]
      }
    }
  }
}
